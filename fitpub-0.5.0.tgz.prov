annotations:
  artifacthub.io/category: skip-prediction
  artifacthub.io/changes: |
    - kind: changed
      description: "Update appVersion to FitPub 1.2.0."
    - kind: added
      description: "FITPUB_ACTUATOR_PASSWORD is now required: 1.2.0 puts every actuator endpoint behind basic auth and the prod profile has no default."
    - kind: changed
      description: "Health probes switched to authenticated actuator groups (exec wget); readiness now drains on graceful shutdown."
    - kind: changed
      description: "Renamed config key FILE_UPLOAD_DIR to FITPUB_FILE_UPLOAD_DIR."
    - kind: changed
      description: "Redirect FITPUB_IMAGES_PATH and FITPUB_TILE_CACHE_PATH to /tmp; their new /app defaults are read-only under readOnlyRootFilesystem."
    - kind: changed
      description: "ServiceMonitor scrapes /actuator/prometheus and needs serviceMonitor.basicAuth against the actuator credentials."
    - kind: added
      description: "FITPUB_CORS_ALLOWED_ORIGINS and FITPUB_ADMIN_EMAILS config keys."
  artifacthub.io/containsSecurityUpdates: "false"
  artifacthub.io/images: |
    - name: fitpub
      image: codeberg.org/fitpub/fitpub:1.2.0
    - name: volume-permissions
      image: busybox:1.37
      whitelisted: true
